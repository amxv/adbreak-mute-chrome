{
  "manifest_version": 3,
  "name": "Adbreak Mute",
  "description": "Automatically mute ad breaks by detecting logo disappearance in a monitored tab.",
  "version": "0.2.0",
  "permissions": ["tabs", "activeTab", "storage", "alarms", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Adbreak Mute",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
